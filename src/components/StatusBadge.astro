---
import { statusLabel, type WniosekStatus } from '../lib/wniosekStatus';

interface Props {
  status: WniosekStatus;
}

const { status } = Astro.props;

const COLORS: Record<WniosekStatus, string> = {
  zlozony: 'bg-slate-100 text-slate-600 border-slate-300',
  oczekiwanie_na_odpowiedz: 'bg-sky-50 text-sky-700 border-sky-300',
  oczekiwanie_na_odwolanie: 'bg-amber-50 text-amber-700 border-amber-300',
  zalatwiony: 'bg-brand text-white border-brand',
  odrzucony: 'bg-red-50 text-red-700 border-red-300',
};
---

<span class={`inline-block rounded-full border px-3 py-0.5 text-xs font-medium ${COLORS[status]}`}>
  {statusLabel(status)}
</span>
