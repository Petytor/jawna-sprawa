---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DocumentPreview from '../../components/DocumentPreview.astro';
import Timeline from '../../components/Timeline.astro';
import StatusBadge from '../../components/StatusBadge.astro';

export async function getStaticPaths() {
  const wnioski = await getCollection('wnioski');
  return wnioski.map((wniosek) => ({ params: { slug: wniosek.id }, props: { wniosek } }));
}

interface Props {
  wniosek: CollectionEntry<'wnioski'>;
}

const { wniosek } = Astro.props;
const { Content } = await render(wniosek);

const ostatniKrok = [...wniosek.data.kroki].sort((a, b) => b.data.valueOf() - a.data.valueOf())[0];
const pierwszyKrok = [...wniosek.data.kroki].sort((a, b) => a.data.valueOf() - b.data.valueOf())[0];
---

<Layout
  title={wniosek.data.tytul}
  description={wniosek.data.instytucja ? `${wniosek.data.tytul} — ${wniosek.data.instytucja}` : wniosek.data.tytul}
  article={{ datePublished: pierwszyKrok.data, dateModified: ostatniKrok.data }}
>
  <p class="mb-4"><a class="text-sm text-brand hover:underline" href={import.meta.env.BASE_URL}>&larr; Wszystkie wpisy</a></p>

  <article>
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold text-brand-dark">{wniosek.data.tytul}</h1>
      <StatusBadge status={ostatniKrok.status} />
    </div>
    {wniosek.data.instytucja && <p class="mt-1 text-sm text-slate-500">{wniosek.data.instytucja}</p>}

    <div class="prose prose-slate mt-6 max-w-none">
      <Content />
    </div>

    {wniosek.data.dokument && (
      <div class="mt-8">
        <DocumentPreview plik={wniosek.data.dokument} />
      </div>
    )}

    <div class="mt-8">
      <h2 class="mb-4 text-lg font-semibold">Przebieg sprawy</h2>
      <Timeline kroki={wniosek.data.kroki} />
    </div>

    {wniosek.data.zalaczniki.length > 0 && (
      <div class="mt-8">
        <h2 class="text-lg font-semibold">Pozostałe załączniki</h2>
        <ul class="mt-2 list-disc pl-5">
          {wniosek.data.zalaczniki.map((z) => (
            <li>
              <a class="text-brand hover:underline" href={z.plik}>{z.nazwa}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Layout>
