---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../site.config';

const statusLabel: Record<string, string> = {
  zlozone: 'Złożone',
  w_toku: 'W toku',
  odpowiedz: 'Jest odpowiedź',
  zalatwione: 'Załatwione',
  odrzucone: 'Odrzucone',
};

const wpisy = (await getCollection('wpisy')).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);
---

<Layout title={site.nazwaSprawy} description={site.opisSprawy}>
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-brand-dark">{site.nazwaSprawy}</h1>
    <p class="mt-2 text-slate-600">{site.opisSprawy}</p>
    <p class="mt-1 text-sm text-slate-400">Prowadzi: {site.prowadzacy}</p>
  </header>

  <ol class="space-y-4">
    {
      wpisy.map((wpis) => (
        <li class="rounded-lg border border-slate-200 p-4">
          <a class="text-lg font-medium text-brand-dark hover:underline" href={`/wpis/${wpis.id}/`}>
            {wpis.data.tytul}
          </a>
          <p class="mt-1 text-sm text-slate-500">
            {wpis.data.data.toLocaleDateString('pl-PL')}
            {wpis.data.urzad && <> · {wpis.data.urzad}</>}
            {' · '}
            <span class="font-medium">{statusLabel[wpis.data.status]}</span>
          </p>
        </li>
      ))
    }
  </ol>

  {wpisy.length === 0 && (
    <p class="text-slate-500">
      Jeszcze nic tu nie ma — dodaj pierwszy wpis w panelu pod adresem <code>/admin</code>.
    </p>
  )}
</Layout>
